# Copy to .env and fill in what you need. Every integration is optional:
# without credentials the app runs on the free RSS sources and in-app notifications.

# --- Core ---------------------------------------------------------------
# SQLite file by default. For PostgreSQL/Supabase:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/travel_edge
DATABASE_URL=
TIMEZONE=Europe/Vilnius
DIGEST_HOUR=8
# Deals at or above this score (or suspected error fares) are sent instantly
INSTANT_MIN_SCORE=85
# Some sources (Wikimedia) require a contact URL in the User-Agent: use your repo or site URL
CONTACT_URL=https://github.com/your-account/travel-edge

# --- Flight price API (free partner account: https://www.travelpayouts.com) ---
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_MAX_AIRPORTS=12

# --- Live airline prices (https://app.duffel.com – self sign-up) -------------
# Re-checks the best flight deals directly with airlines before alerting you.
# Searches without bookings are billed (~$0.005 each beyond the free ratio) and Duffel may cap search-only use –
# confirm with Duffel first. Keep the cap low.
DUFFEL_TOKEN=
DUFFEL_MAX_CHECKS_PER_DAY=10
DUFFEL_MIN_SCORE=85
# Flight deals from blogs (TravelFree, Fly4free…) are shown next to fare-API flights. Set false for APIs only.
RSS_FLIGHTS=true

# --- Notifications --------------------------------------------------------
# Telegram: create a bot with @BotFather, send it a message, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (any SMTP provider: Gmail app password, Brevo, Postmark, SES…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Mobile push via ntfy (free app for iOS/Android). Use a long random topic name.
NTFY_TOPIC_URL=

# WhatsApp Cloud API (Meta Business account + approved number; templates needed outside 24h window)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# Facebook Messenger Send API (Page + approved app; recipient must have messaged the Page)
MESSENGER_PAGE_TOKEN=
MESSENGER_PSID=

# Generic JSON webhook (Slack/Discord/Make/Zapier)
WEBHOOK_URL=
