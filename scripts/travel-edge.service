# systemd units for a Linux VPS without Docker. Copy twice (api + worker), adjust paths/user, then:
#   sudo systemctl enable --now travel-edge-api travel-edge-worker
[Unit]
Description=TravelEdge worker (background deal scanner)
After=network-online.target

[Service]
User=travel
WorkingDirectory=/opt/travel-edge/backend
EnvironmentFile=/opt/travel-edge/.env
ExecStart=/opt/travel-edge/.venv/bin/python -m app.worker
# For the API unit use instead:
# ExecStart=/opt/travel-edge/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
